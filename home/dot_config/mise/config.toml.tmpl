[tools]
# editor + dotfiles tooling
neovim = "0.12"
tree-sitter = "0.27"
gitleaks = "8"
chezmoi = "latest"
fzf = "0.56.3"
zoxide = "0"
{{- if not .ephemeral }}

# languages (non-container machines)
lua = "5.1.5"
babashka = "1.12.195"
clojure = "1.12.0.1479"
java = "21"
node = "24"
python = "3.15.0"
go = "1.26.3"
maven = "latest"
uv = "latest"
{{- end }}

[settings]
idiomatic_version_file_enable_tools = ["python"]

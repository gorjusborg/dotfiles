{{- /*
  Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
  Answers are remembered; re-ask with `chezmoi init --prompt`.
  Non-interactive: `chezmoi init --promptDefaults`, or answer by prompt text,
  e.g. `--promptBool "Work machine"=true`.
*/ -}}

{{- /* OS + distro in one value, per chezmoi's Linux guide: darwin, windows, linux-arch, linux-debian, ... */ -}}
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- /* Stable hostname, per chezmoi's macOS guide (`hostname` varies with the network there) */ -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "ComputerName" | trim -}}
{{- end -}}

{{- /* WSL detection, per chezmoi's Windows guide */ -}}
{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $wsl = true -}}
{{-   end -}}
{{- end -}}

{{- /* Containers (devcontainers, Codespaces, docker/podman) get a minimal, prompt-free, secret-free setup */ -}}
{{- $ephemeral := or (env "CODESPACES") (env "REMOTE_CONTAINERS") (stat "/.dockerenv") (stat "/run/.containerenv") | not | not -}}

{{- /* All path answers are absolute; defaults are built from the home directory. */ -}}
{{- $defaultSshKey := joinPath .chezmoi.homeDir ".ssh" "id_ed25519" -}}
{{- $work := false -}}
{{- $notesDir := joinPath .chezmoi.homeDir "mega" "tn" "notes" -}}
{{- $sshKeyPersonal := $defaultSshKey -}}
{{- $sshKeyWork := "" -}}
{{- $workGitName := "" -}}
{{- $workGitEmail := "" -}}
{{- $workJavaTrustStore := "" -}}
{{- $keepassxcDb := "" -}}
{{- $keepassxcYubikey := "" -}}
{{- if not $ephemeral -}}
{{-   $work = promptBoolOnce . "work" "Work machine" false -}}
{{-   $notesDir = promptStringOnce . "notesDir" "Notes directory (absolute path)" $notesDir -}}
{{-   $sshKeyPersonal = promptStringOnce . "sshKeyPersonal" "Personal git SSH key (absolute path)" $sshKeyPersonal -}}
{{-   if $work -}}
{{-     $sshKeyWork = promptStringOnce . "sshKeyWork" "Work git SSH key (absolute path)" $defaultSshKey -}}
{{-     $workGitName = promptStringOnce . "workGitName" "Work git name" -}}
{{-     $workGitEmail = promptStringOnce . "workGitEmail" "Work git email" -}}
{{-     $workJavaTrustStore = promptStringOnce . "workJavaTrustStore" "Work Java truststore (absolute path, blank for none)" "" -}}
{{-   end -}}
{{-   $keepassxcDb = promptStringOnce . "keepassxcDb" "KeePassXC database (absolute path, blank to disable secrets)" "" -}}
{{-   if $keepassxcDb -}}
{{-     $keepassxcYubikey = promptStringOnce . "keepassxcYubikey" "KeePassXC YubiKey slot[:serial] (blank for none)" "" -}}
{{-   end -}}
{{- end -}}
{{- range $name, $path := dict "notesDir" $notesDir "sshKeyPersonal" $sshKeyPersonal "sshKeyWork" $sshKeyWork "workJavaTrustStore" $workJavaTrustStore "keepassxcDb" $keepassxcDb -}}
{{-   if and $path (not (osIsAbs $path)) -}}
{{-     fail (printf "%s must be an absolute path, got %q (re-answer with `chezmoi init --prompt`)" $name $path) -}}
{{-   end -}}
{{- end -}}
{{- $secrets := ne $keepassxcDb "" -}}

[data]
    osid = {{ $osid | quote }}
    hostname = {{ $hostname | quote }}
    wsl = {{ $wsl }}
    ephemeral = {{ $ephemeral }}
    secrets = {{ $secrets }}
    work = {{ $work }}
    notesDir = {{ $notesDir | quote }}
    sshKeyPersonal = {{ $sshKeyPersonal | quote }}
    sshKeyWork = {{ $sshKeyWork | quote }}
    workGitName = {{ $workGitName | quote }}
    workGitEmail = {{ $workGitEmail | quote }}
    workJavaTrustStore = {{ $workJavaTrustStore | quote }}
    keepassxcDb = {{ $keepassxcDb | quote }}
    keepassxcYubikey = {{ $keepassxcYubikey | quote }}

[add]
    secrets = "error"
{{- if $secrets }}

[keepassxc]
    database = {{ $keepassxcDb | quote }}
{{- if $keepassxcYubikey }}
    # default cache-password mode: chezmoi asks for the password once, and
    # keepassxc-cli does a YubiKey challenge per lookup. ("open" mode can't
    # handle a database that needs both a password and a YubiKey.)
    args = ["--yubikey", {{ $keepassxcYubikey | quote }}]
{{- end }}
{{- end }}
{{- if and (eq .chezmoi.os "windows") (lookPath "pwsh") }}

[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo"]
{{- end }}

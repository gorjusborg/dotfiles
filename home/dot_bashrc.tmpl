# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# Double check to make sure this shell is in fact interactive.
# This allows for login shells to source interactive shell config safely.
case $- in
    *i*) ;;
      *) return;;
esac

function cmd_exists() {
  command -v "$1" &> /dev/null
}

{{ if not .ephemeral -}}
# start tmux if available
if [[ $(command -v tmux ) && -z "$TMUX" ]]; then
  exec $SHELL -c 'tmux new-session'
fi

{{ end -}}
# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

{{ if or (eq .osid "linux-debian") (eq .osid "linux-ubuntu") -}}
# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

{{ end -}}
# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|xterm-ghostty|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

{{ if eq .osid "linux-arch" -}}
# source git prompt if available
GIT_PROMPT_SCRIPT='/usr/share/git/completion/git-prompt.sh'
if [ -f "$GIT_PROMPT_SCRIPT" ]; then
  . "$GIT_PROMPT_SCRIPT"
fi

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
if cmd_exists brew; then
  compd_loc="$(brew --prefix)/etc/bash_completion.d/git-prompt.sh"
  if [ -f "$compd_loc" ]; then
    . "$compd_loc"
  fi
fi

{{ end -}}
# keep the prompt working where git's prompt helper isn't installed
cmd_exists __git_ps1 || __git_ps1() { :; }

{{ $chroot := "" -}}
{{ if or (eq .osid "linux-debian") (eq .osid "linux-ubuntu") -}}
{{   $chroot = "${debian_chroot:+($debian_chroot)}" -}}
{{ end -}}
if [ "$color_prompt" = yes ]; then
    export GIT_PS1_SHOW{DIRTYSTATE,STASHSTATE,UNTRACKEDFILES,COLORHINTS}=1
    PS1='[\!] {{ $chroot }}\[\033[01;32m\]\u@\h\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\n$(__git_ps1 "[%s] ")->> '
else
    export GIT_PS1_SHOW{DIRTYSTATE,STASHSTATE,UNTRACKEDFILES}=1
    PS1='[\!] {{ $chroot }}\u@\h \w\n$(__git_ps1 "[%s] ")->> '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;{{ $chroot }}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

alias ls='ls --color=auto'

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
#alias ll='ls -l'
#alias la='ls -A'
#alias l='ls -CF'

# if rlwrap is installed, use it when calling babashka via shell
if cmd_exists rlwrap; then
  alias bb='rlwrap bb'
fi

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
{{- if eq .chezmoi.os "darwin" }}
  elif cmd_exists brew; then
    CMP_ENTRYPNT="$(brew --prefix)/etc/profile.d/bash_completion.sh"
    if [ -f "$CMP_ENTRYPNT" ]; then
      . "$CMP_ENTRYPNT" # slow, but use bash_completion@2 which lazy loads helps
    fi
{{- end }}
  fi
fi

if [[ -f "$HOME/.ghc_aliases.bash" ]]; then
  . "$HOME/.ghc_aliases.bash"
fi

# vv manually added vv
set -o vi

# activate mise for bash
if cmd_exists mise; then
  eval "$(mise activate bash)"
fi

# Set up fzf key bindings and fuzzy completion
if cmd_exists fzf; then
  eval "$(fzf --bash)"
fi

# Set up lua
if cmd_exists luarocks; then
  eval "$(luarocks path --bin)"
fi

if cmd_exists zoxide; then
  eval "$(zoxide init bash)"
fi

export TN_NOTES_DIR={{ .notesDir | quote }}

# identify the current network (see ~/.config/netid/netid.yaml)
export NETID="$(netid 2>/dev/null)"
# NETID can fall back to the raw DHCP search domain, so keep it from becoming a path
case "$NETID" in *[!A-Za-z0-9._-]*) NETID= ;; esac
if [ -n "$NETID" ] && [ -f "$HOME/.config/netid/$NETID.env" ]; then
  set -a
  . "$HOME/.config/netid/$NETID.env"
  set +a
fi

alias nv="nvim"
alias nvc="nvim --clean"

function vpr() {
  local base_branch="${1:-main}"
  nvim . -c ":DiffviewFileHistory --range=${base_branch}..HEAD --no-merges --reverse"
}

{{ if eq .chezmoi.os "linux" -}}
# macOS-style clipboard commands on Wayland
if cmd_exists wl-copy; then
  alias pbcopy="wl-copy"
  alias pbpaste="wl-paste"
fi

# use podman where docker isn't installed
if ! cmd_exists docker && cmd_exists podman; then
  alias docker=podman
fi

{{ end -}}
# work-specific shell setup, kept out of this repo
if [ -f "$HOME/.work.bashrc" ]; then
  . "$HOME/.work.bashrc"
fi

# colima / docker
#export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock" # using docker desktop currently
